@model IEnumerable<Companies_Address_Book.Models.Entities.Company>
@{
    ViewData["Title"] = "Companies Address Book";
}

<div class="container py-4">
    <!-- Header & Action Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 mb-1">Companies Directory</h1>
            <p class="text-muted mb-0">Manage and view company records in the database</p>
        </div>
        <div>
            <form asp-controller="Home" asp-action="Import" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-2">
                <input type="file" name="file" id="fileInput" class="form-control form-control-sm" accept=".txt" required style="max-width: 280px;" />
                <button type="submit" class="btn btn-primary btn-sm px-3 shadow-sm text-nowrap" id="btnImport">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-arrow-down me-1" viewBox="0 0 16 16">
                        <path d="M8.5 6.5a.5.5 0 0 0-1 0v3.793L6.354 9.146a.5.5 0 1 0-.708.708l2 2a.5.5 0 0 0 .708 0l2-2a.5.5 0 0 0-.708-.708L8.5 10.293z"/>
                        <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/>
                    </svg>
                    Import Companies
                </button>
            </form>
        </div>
    </div>

    <!-- Companies Data Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Database Records</h5>
            <span class="badge bg-secondary">@(Model?.Count() ?? 0) Companies</span>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width: 80px;" class="text-center">#</th>
                                <th scope="col">Company Name</th>
                                <th scope="col" class="text-center" style="width: 180px;">Number of Contacts</th>
                                <th scope="col" class="text-center" style="width: 180px;">Max Contact Age</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var company in Model)
                            {
                                <tr>
                                    <td class="text-center text-muted">@company.Id</td>
                                    <td class="fw-semibold">@company.Name</td>
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark">@company.NumContacts</span>
                                    </td>
                                    <td class="text-center">
                                        @(company.MaxContactsAge.HasValue ? company.MaxContactsAge.Value.ToString() : "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center">
                    <div class="py-4">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-inbox text-muted mb-3" viewBox="0 0 16 16">
                            <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zm9.954 5H10.45a2.5 2.5 0 0 1-4.9 0H1.066l.32 2.562a.5.5 0 0 0 .497.438h12.234a.5.5 0 0 0 .496-.438zM3.809 3.563A1.5 1.5 0 0 1 4.981 3h6.038a1.5 1.5 0 0 1 1.172.563l3.7 4.625a1 1 0 0 1 .109 1.036l-.68 5.441a1 1 0 0 1-.992.873H2.872a1 1 0 0 1-.992-.873l-.68-5.441a1 1 0 0 1 .109-1.036z"/>
                        </svg>
                        <h5 class="text-secondary">No Companies in Database</h5>
                        <p class="text-muted mb-3">The companies table is currently empty.</p>
                        <p class="small text-muted mb-0">Choose a file from your device and click <strong>Import Companies</strong> to parse and inspect company records.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
